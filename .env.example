# App
NODE_ENV=development

# Backend — pentru `npm run dev` (API-ul pe mașina gazdă)
API_URL=http://localhost:5000
API_BASE_PATH=/api/v1
SESSION_NAME=sessionId

# Docker — adresa API-ului din rețeaua compose (numele serviciului, nu localhost).
# `next build` o scrie în rewrite-uri, deci o schimbare cere rebuild de imagine.
API_URL_DOCKER=http://api:5000
WEB_PORT=3000
